{
  "preparedAt": "2026-11-02T05:29:40.496864+00:00",
  "purpose": "七类 UI 待确认问题截图；仅整理证据，未修改产品 UI。",
  "limitations": [
    "原生截图均为既有本地验证截图，非本次抓取或当前电视实拍。",
    "原型于 2026-11-02 渲染，只代表设计稿；后续 BACK 等产品决策优先。",
    "无本次原生、DPAD、动态视频或实体电视验证。"
  ],
  "issues": [
    {
      "id": "A01",
      "title": "辅助文字偏小",
      "description": "确认详情状态、剧集来源和进度、设置说明等小字的阅读尺度。"
    },
    {
      "id": "A02",
      "title": "焦点轮廓偏重、表达不一",
      "description": "确认主按钮双框，以及导航、列表和播放器焦点的强调强度。"
    },
    {
      "id": "A03",
      "title": "容器和边框层层叠加",
      "description": "确认工具页、番剧子页和播放设置中的面板、卡片与行边界。"
    },
    {
      "id": "A04",
      "title": "媒体库作品标题重复",
      "description": "同一作品名称在图片下沿和图片下方各出现一次。"
    },
    {
      "id": "A05",
      "title": "连接表单主次不够清楚",
      "description": "确认基础地址、认证信息与编码、连接模式、TLS 等高级项的分组。"
    },
    {
      "id": "A06",
      "title": "播放侧栏的前后层次较弱",
      "description": "确认深色面板、普通行与视频背景之间的分离程度；不涉及已接受的字幕位置。"
    },
    {
      "id": "A07",
      "title": "关于页标识缺少播放图形",
      "description": "品牌位置显示空白圆角方块，缺少主体图形。"
    }
  ],
