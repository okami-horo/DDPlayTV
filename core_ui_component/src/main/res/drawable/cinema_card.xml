<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="12dp"/><solid android:color="@color/cinema_elevated"/><stroke android:width="3dp" android:color="@color/cinema_text"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="12dp"/><solid android:color="@color/cinema_elevated"/></shape>
    </item>
    <item>
        <shape><corners android:radius="12dp"/><solid android:color="@color/cinema_surface"/></shape>
    </item>
</selector>
