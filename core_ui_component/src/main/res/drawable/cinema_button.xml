<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="12dp"/><solid android:color="@color/cinema_text"/><stroke android:width="2dp" android:color="@color/white"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="12dp"/><solid android:color="#D8D8E0"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><corners android:radius="12dp"/><solid android:color="@color/cinema_elevated"/><stroke android:width="1dp" android:color="#88FFFFFF"/></shape>
    </item>
    <item>
        <shape><corners android:radius="12dp"/><solid android:color="@color/cinema_surface"/></shape>
    </item>
</selector>
