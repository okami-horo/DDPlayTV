                android:width="2dp"
                android:color="@color/cinema_text" />
        </shape>
    </item>
    <item
        android:state_selected="true">
        <shape>
            <corners
                android:radius="10dp" />
            <solid
                android:color="@color/cinema_text" />
        </shape>
    </item>
    <item>
        <shape>
            <corners
                android:radius="10dp" />
            <solid
                android:color="@color/cinema_elevated" />
        </shape>
    </item>
