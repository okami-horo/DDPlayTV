<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="0dp" android:paddingTop="0dp" android:paddingRight="0dp" android:paddingBottom="0dp">
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/cinema_navigation_fill" />
        </shape>
    </item>
    <item android:width="20dp" android:height="2dp" android:gravity="bottom|center_horizontal" android:bottom="3dp">
        <shape>
            <corners android:radius="1dp" />
            <solid android:color="@color/cinema_selection_marker" />
        </shape>
    </item>
</layer-list>
