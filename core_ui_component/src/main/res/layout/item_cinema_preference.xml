<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="68dp" android:paddingVertical="15dp" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/cinema_text" android:textSize="16sp" android:maxLines="2" />
        <TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/cinema_muted" android:textSize="11sp" android:maxLines="4" />
    </LinearLayout>
    <TextView android:id="@+id/cinema_preference_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="170dp" android:layout_marginStart="16dp" android:textColor="@color/cinema_muted" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@android:id/widget_frame" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:gravity="center" />
    <ImageView android:id="@+id/cinema_preference_arrow" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
</LinearLayout>