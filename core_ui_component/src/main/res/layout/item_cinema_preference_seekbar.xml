<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="96dp" android:padding="14dp" android:background="@drawable/cinema_card" android:focusable="true">
    <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/cinema_text" android:textSize="16sp" />
    <TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/cinema_muted" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <SeekBar android:id="@+id/seekbar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:focusable="false" android:progressTint="@color/cinema_text" android:thumbTint="@color/cinema_text" />
        <TextView android:id="@+id/seekbar_value" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/cinema_text" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
