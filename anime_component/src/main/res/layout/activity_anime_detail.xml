<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import
            type="com.xyoye.anime_component.ui.activities.anime_detail.AnimeDetailViewModel" />
        <variable
            name="viewModel"
            type="com.xyoye.anime_component.ui.activities.anime_detail.AnimeDetailViewModel" />
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cinema_background">
        <ImageView
            android:id="@+id/background_cover_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#DD111114" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                app:title="番剧详情"
                app:titleMarginEnd="80dp"
                app:titleTextColor="@color/cinema_text"
                android:paddingHorizontal="24dp"
                app:titleTextAppearance="@style/Cinema.Title" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:paddingHorizontal="36dp"
                android:paddingBottom="24dp">
                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="28dp">
                    <ImageView
                        android:id="@+id/cover_iv"
                        android:layout_width="140dp"
                        android:layout_height="210dp"
                        android:contentDescription="@null"
                        android:background="@drawable/cinema_image"
                        android:scaleType="centerCrop"
                        android:transitionName="cover_image"
                        android:clipToOutline="true" />
                    <TextView
                        android:id="@+id/follow_tv"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/cinema_button"
                        android:gravity="center"
                        android:onClick="@{() -> viewModel.followAnime()}"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/anime_no_follow"
                        android:textColor="@color/cinema_text"
                        android:textSize="14sp"
                        android:focusable="true"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/title_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.animeTitleField}"
                        android:textColor="@color/text_white_immutable"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="测试"
                        android:maxLines="2"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/status_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@{viewModel.animeStatusField}"
                        android:textColor="@color/text_white_immutable"
                        android:textSize="14sp"
                        tools:text="状态：连载中" />
                    <TextView
                        android:id="@+id/type_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@{viewModel.animeTypeField}"
                        android:textColor="@color/text_white_immutable"
                        android:textSize="14sp"
                        tools:text="类型：网络放送" />
                    <TextView
                        android:id="@+id/rating_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@{viewModel.animeRateField}"
                        android:textColor="@color/text_white_immutable"
                        android:textSize="14sp"
                        tools:text="评分：7.0" />
                    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
                        android:id="@+id/tab_layout"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viewpager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@drawable/cinema_surface"
                        tools:background="@color/transparent"
                        android:layout_weight="1"
                        android:padding="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</layout>
