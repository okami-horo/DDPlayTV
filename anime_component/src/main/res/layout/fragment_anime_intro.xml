<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import
            type="android.view.View" />
        <variable
            name="viewModel"
            type="com.xyoye.anime_component.ui.fragment.anime_intro.AnimeIntroFragmentViewModel" />
    </data>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/intro_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:focusable="true"
        android:clipToPadding="false"
        android:padding="4dp"
        android:background="@drawable/cinema_reading_focus">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tag_rv"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:visibility="gone"
                app:tvDpadList="true" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/status_tv"
                        style="@style/Cinema.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.animeStatusField}" />
                    <TextView
                        android:id="@+id/status_tips"
                        style="@style/Cinema.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="播出状态"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/type_tv"
                        style="@style/Cinema.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.animeTypeField}" />
                    <TextView
                        android:id="@+id/type_tips"
                        style="@style/Cinema.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="作品类型"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/rating_tv"
                        style="@style/Cinema.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.animeRatingField}" />
                    <TextView
                        android:id="@+id/rating_tips"
                        style="@style/Cinema.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="评分"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="@{viewModel.hideInfoFiled ? View.GONE : View.VISIBLE}">
                <TextView
                    android:id="@+id/anime_info_tips"
                    style="@style/Cinema.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="作品资料" />
                <TextView
                    android:id="@+id/anime_info_tv"
                    style="@style/Cinema.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.animeInfoFiled}"
                    android:layout_marginTop="8dp"
                    android:maxLines="@{viewModel.expandInfoFiled ? 100 : 3}"
                    android:ellipsize="end" />
                <Button
                    android:id="@+id/anime_info_expend_ll"
                    style="@style/Cinema.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@{viewModel.expandStatusFiled}"
                    android:layout_marginTop="8dp"
                    android:onClick="@{() -&gt; viewModel.toggleInfoExpend()}" />
            </LinearLayout>
            <TextView
                android:id="@+id/intro_tips"
                style="@style/Cinema.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="剧情简介"
                android:layout_marginTop="16dp" />
            <TextView
                android:id="@+id/intro_tv"
                style="@style/Cinema.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{viewModel.hideIntroFiled ? @string/cinema_no_synopsis : viewModel.animeIntroFiled}"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>