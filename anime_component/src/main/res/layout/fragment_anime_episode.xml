<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import
            type="android.view.View" />
        <variable
            name="viewModel"
            type="com.xyoye.anime_component.ui.fragment.anime_episode.AnimeEpisodeFragmentViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/title_cl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/episode_count_tv"
                style="@style/Cinema.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@{viewModel.episodeCountField}" />
            <Button
                android:id="@+id/mark_mode_bt"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="批量标记"
                android:nextFocusRight="@id/sort_cl" />
            <LinearLayout
                android:id="@+id/sort_cl"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:background="@drawable/cinema_button"
                android:focusable="true"
                android:clickable="true"
                android:gravity="center"
                android:onClick="@{() -&gt; viewModel.toggleSort()}"
                android:nextFocusLeft="@id/mark_mode_bt">
                <TextView
                    android:id="@+id/sort_tv"
                    style="@style/Cinema.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正序"
                    android:textColor="@color/cinema_text" />
                <ImageView
                    android:id="@+id/sort_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_change_sort"
                    app:tint="@color/cinema_text"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/action_layout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/tv_set_read"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="标记看过"
                android:nextFocusRight="@id/tv_exit_mark" />
            <Button
                android:id="@+id/tv_exit_mark"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="退出"
                android:nextFocusLeft="@id/tv_set_read"
                android:nextFocusRight="@id/tv_mark_all" />
            <Button
                android:id="@+id/tv_mark_all"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="全选"
                android:nextFocusLeft="@id/tv_exit_mark"
                android:nextFocusRight="@id/tv_invert_mark" />
            <Button
                android:id="@+id/tv_invert_mark"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="反选"
                android:nextFocusLeft="@id/tv_mark_all" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episode_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:clipToPadding="false"
                app:tvDpadList="true" />
            <TextView
                android:id="@+id/empty_tv"
                style="@style/Cinema.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无分集信息"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</layout>