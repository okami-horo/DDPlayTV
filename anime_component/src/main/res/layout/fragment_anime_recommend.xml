<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.xyoye.anime_component.ui.fragment.anime_recommend.AnimeRecommendFragmentViewModel" />
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommend_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="@{viewModel.hideRecommendFiled &amp;&amp; viewModel.hideRecommendMoreFiled ? View.GONE : View.VISIBLE}"
            app:tvDpadList="true" />
        <TextView
            android:id="@+id/empty_tv"
            style="@style/Cinema.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无推荐作品"
            android:gravity="center"
            android:padding="36dp"
            android:visibility="@{viewModel.hideRecommendFiled &amp;&amp; viewModel.hideRecommendMoreFiled ? View.VISIBLE : View.GONE}" />
    </FrameLayout>
</layout>
