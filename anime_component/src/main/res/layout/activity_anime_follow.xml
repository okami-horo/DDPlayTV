<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.xyoye.anime_component.ui.activities.anime_follow.AnimeFollowViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cinema_background"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingBottom="24dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            app:titleTextColor="@color/cinema_text"
            app:titleTextAppearance="@style/Cinema.Title" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/search_et"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:background="@drawable/cinema_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/cinema_muted"
                android:textSize="14sp"
                android:hint="搜索当前列表"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:nextFocusRight="@id/clear_bt" />
            <Button
                android:id="@+id/clear_bt"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="清空"
                android:layout_marginStart="12dp"
                android:nextFocusLeft="@id/search_et"
                android:nextFocusRight="@id/refresh_bt" />
            <Button
                android:id="@+id/refresh_bt"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="刷新"
                android:layout_marginEnd="0dp"
                android:nextFocusLeft="@id/clear_bt" />
        </LinearLayout>
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:id="@+id/status_tv"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:accessibilityLiveRegion="polite" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/cinema_surface"
            android:padding="12dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/follow_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="4dp"
                app:tvDpadList="true" />
            <LinearLayout
                android:id="@+id/empty_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/empty_title_tv"
                    style="@style/Cinema.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center" />
                <TextView
                    android:id="@+id/empty_message_tv"
                    style="@style/Cinema.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</layout>