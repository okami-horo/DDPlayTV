<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"><data><variable name="viewModel" type="com.xyoye.storage_component.ui.fragment.storage_file.StorageFileFragmentViewModel"/></data>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
<androidx.constraintlayout.widget.Guideline android:id="@+id/list_edge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.585"/>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/refresh_layout" android:layout_width="0dp" android:layout_height="match_parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/list_edge">
<androidx.recyclerview.widget.RecyclerView android:id="@+id/storage_file_rv" app:tvDpadList="true" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
<LinearLayout android:id="@+id/preview_panel" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="17dp" android:layout_marginEnd="4dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@drawable/file_browser_panel" android:clipToOutline="true" android:orientation="vertical" android:descendantFocusability="blocksDescendants" android:focusable="false" app:layout_constraintStart_toEndOf="@id/list_edge" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
<FrameLayout android:id="@+id/preview_art" android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/file_browser_folder_art">
<ImageView android:id="@+id/preview_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
<ImageView android:id="@+id/preview_icon" android:layout_width="72dp" android:layout_height="58dp" android:layout_gravity="center" android:src="@drawable/file_browser_folder" android:importantForAccessibility="no"/>
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:orientation="vertical">
<TextView android:includeFontPadding="false" android:id="@+id/preview_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/cinema_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="3" android:ellipsize="end"/>
<TextView android:includeFontPadding="false" android:id="@+id/preview_details" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#9999A7" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="6dp"/>
<TextView android:includeFontPadding="false" android:id="@+id/preview_path_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="当前位置" android:textColor="#9999A7" android:textSize="10sp" android:layout_marginTop="7dp"/>
<TextView android:includeFontPadding="false" android:id="@+id/preview_path" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#9999A7" android:textSize="11sp" android:maxLines="1" android:ellipsize="middle" android:layout_marginTop="6dp"/>
<TextView android:includeFontPadding="false" android:id="@+id/preview_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/cinema_text" android:textSize="11sp" android:layout_marginTop="7dp" android:maxLines="1"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/browser_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:visibility="gone">
<ProgressBar android:id="@+id/loading" android:layout_width="40dp" android:layout_height="40dp" android:visibility="gone"/>
<ImageView android:id="@+id/empty_icon" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/file_browser_folder" android:importantForAccessibility="no"/>
<TextView android:id="@+id/empty_tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/cinema_text" android:textSize="19sp" android:layout_marginTop="16dp"/>
<TextView android:id="@+id/empty_description" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#9999A7" android:textSize="13sp" android:layout_marginTop="8dp"/>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp">
<Button android:id="@+id/empty_action_tv" style="@style/Cinema.Primary" android:layout_width="wrap_content" android:layout_height="40dp"/>
<Button android:id="@+id/empty_back" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="40dp" android:text="返回上一级"/>
</LinearLayout></LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
