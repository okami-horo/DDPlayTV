<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">
        <FrameLayout
            android:id="@+id/login_app_container"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/cinema_surface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:background="@drawable/cinema_surface"
                android:gravity="center"
                android:text="设备来源"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/login_app_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_theme"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/login_app_select_tv"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/cinema_button"
                android:focusable="true"
                android:gravity="center"
                android:text="选择"
                android:textColor="@color/text_black"
                android:textSize="14sp" />
        </FrameLayout>
        <ImageView
            android:id="@+id/qr_code_iv"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_app_container" />
        <ProgressBar
            android:id="@+id/loading_pb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/qr_code_iv"
            app:layout_constraintEnd_toEndOf="@id/qr_code_iv"
            app:layout_constraintStart_toStartOf="@id/qr_code_iv"
            app:layout_constraintTop_toTopOf="@id/qr_code_iv" />
        <TextView
            android:id="@+id/status_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text=" "
            android:textColor="@color/cinema_text"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/qr_code_iv"
            android:minHeight="44dp" />
        <TextView
            android:id="@+id/hint_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="提示：授权信息仅保存在本机，可在媒体库管理中移除存储源以清除"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/status_tv" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
