<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import
            type="com.xyoye.data_component.entity.MediaLibraryEntity" />
        <import
            type="android.view.View" />
        <variable
            name="library"
            type="MediaLibraryEntity" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_server_address"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/address_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/address_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_server_address"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@={library.url}"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_display_name"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/display_name_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/display_name_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_display_name"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@={library.displayName}"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_login_account"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/account_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/account_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_login_account"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@={library.account}"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/password_fl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/hint_login_password"
                    android:textColor="@color/cinema_muted"
                    android:textSize="12sp"
                    android:labelFor="@id/password_et" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/password_et"
                    android:background="@drawable/cinema_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_login_password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="50dp"
                    android:singleLine="true"
                    android:text="@={library.password}"
                    android:textColor="@color/cinema_text"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="42dp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/password_toggle_iv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="10dp"
                android:contentDescription="显示或隐藏密码"
                android:padding="15dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_input_visible"
                android:focusable="true"
                android:background="@drawable/cinema_icon_circle" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cinema_surface">
            <TextView
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:background="@drawable/cinema_surface"
                android:gravity="center"
                android:text="@string/tips_test_connect"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/server_status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_theme"
                android:textSize="14sp"
                tools:text="连接成功" />
            <TextView
                android:id="@+id/server_test_connect_tv"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/cinema_category"
                android:gravity="center"
                android:text="@string/action_test_server"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:focusable="true" />
        </FrameLayout>
    </LinearLayout>
</layout>
