<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import
            type="com.xyoye.data_component.entity.MediaLibraryEntity" />
        <import
            type="com.xyoye.common_component.weight.binding.BindingConverter" />
        <import
            type="com.xyoye.common_component.weight.binding.BindingEncode" />
        <import
            type="android.view.View" />
        <variable
            name="remoteData"
            type="MediaLibraryEntity" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_server_address"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/address_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/address_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_server_address"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@={remoteData.url}"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_display_name"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/display_name_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/display_name_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_display_name"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@={remoteData.displayName}"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_remote_secret"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/secret_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/secret_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_remote_secret"
                android:maxLines="1"
                android:nextFocusDown="@id/server_test_connect_tv"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@={BindingEncode.stringDecode(remoteData.remoteSecret)}"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/scan_ll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_button_corner_blue"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/ic_remote_scan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/action_remote_scan"
                android:textColor="@color/text_white_immutable"
                android:textSize="16sp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cinema_surface">
            <TextView
                android:id="@+id/server_status_tips"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:background="@drawable/cinema_surface"
                android:gravity="center"
                android:text="@string/tips_test_connect"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/server_status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_theme"
                android:textSize="14sp"
                tools:text="连接成功" />
            <TextView
                android:id="@+id/server_test_connect_tv"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/cinema_category"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/secret_et"
                android:scaleType="centerInside"
                android:text="@string/action_test_server"
                android:textColor="@color/text_black"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</layout>
