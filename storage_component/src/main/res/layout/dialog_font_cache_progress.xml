<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/cinema_surface"
        android:padding="20dp">
        <TextView
            style="@style/Cinema.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_font_cache_title"
            android:id="@+id/title_tv"
            android:textSize="18sp" />
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="将目录中的字体缓存到本机，用于字幕显示。"
            android:id="@+id/subtitle_tv"
            android:layout_marginTop="18dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">
            <TextView
                style="@style/Cinema.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="正在准备…"
                android:id="@+id/progress_state_tv" />
            <TextView
                style="@style/Cinema.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:id="@+id/progress_percent_tv" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress_pb"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:progressTint="@color/cinema_text"
            android:progressBackgroundTint="@color/cinema_elevated"
            android:indeterminate="false"
            android:max="100" />
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_font_cache_progress_default"
            android:id="@+id/progress_tv"
            android:layout_marginTop="16dp" />
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="完成后自动关闭，请稍候。"
            android:id="@+id/notice_tv"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</layout>