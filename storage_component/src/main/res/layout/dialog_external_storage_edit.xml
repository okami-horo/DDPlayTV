<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import
            type="com.xyoye.data_component.entity.MediaLibraryEntity" />
        <import
            type="android.view.View" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/display_name_field"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_display_name"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/display_name_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/display_name_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_display_name"
                android:maxLines="1"
                android:nextFocusDown="@id/select_root_tv"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/path_tv"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_layout_corner_light"
            android:gravity="center_vertical"
            android:hint="@string/hint_root_path"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:textColor="@color/text_gray"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/display_name_field" />
        <TextView
            android:id="@+id/select_root_tv"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cinema_primary"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@id/display_name_et"
            android:text="@string/action_select_root"
            android:textColor="@color/cinema_background"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/path_tv" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
