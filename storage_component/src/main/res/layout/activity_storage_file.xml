<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"><data><variable name="viewModel" type="com.xyoye.storage_component.ui.activities.storage_file.StorageFileViewModel"/></data>
<LinearLayout android:id="@+id/coordinator_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cinema_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:paddingStart="36dp" android:paddingEnd="36dp" android:gravity="center_vertical">
<ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/cinema_brand" android:padding="4dp" android:src="@drawable/cinema_ic_play" app:tint="@color/cinema_background" android:importantForAccessibility="no"/>
<TextView android:id="@+id/browser_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DDPlayTV" android:textColor="@color/cinema_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:layout_marginStart="8dp" android:layout_marginEnd="34dp"/>
<TextView android:id="@+id/browser_nav_0" style="@style/FileBrowser.Nav" android:layout_width="wrap_content" android:layout_height="36dp" android:text="首页"/>
<TextView android:id="@+id/browser_nav_1" style="@style/FileBrowser.Nav" android:layout_width="wrap_content" android:layout_height="36dp" android:text="媒体库"/>
<TextView android:id="@+id/browser_nav_2" style="@style/FileBrowser.Nav" android:layout_width="wrap_content" android:layout_height="36dp" android:text="搜索"/>
<TextView android:id="@+id/browser_nav_3" style="@style/FileBrowser.Nav" android:layout_width="wrap_content" android:layout_height="36dp" android:text="设置"/>
<Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="14sp" android:textColor="@color/cinema_muted"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="16dp" android:paddingStart="36dp" android:paddingEnd="36dp" android:gravity="center_vertical">
<ImageButton android:id="@+id/browser_back" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/cinema_category" android:src="@drawable/cinema_ic_back" app:tint="@color/cinema_text" android:padding="6dp" android:contentDescription="返回上一级"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="13dp" android:orientation="vertical">
<TextView android:id="@+id/source_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/cinema_text" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/source_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="浏览文件" android:textColor="#9999A7" android:textSize="11sp"/>
</LinearLayout>
<TextView android:id="@+id/browser_search" android:drawableStart="@drawable/file_browser_search" android:drawablePadding="6dp" style="@style/FileBrowser.Tool" android:layout_width="wrap_content" android:layout_height="36dp" android:text="搜索" android:textColor="@color/cinema_text"/>
<TextView android:id="@+id/browser_sort" android:drawableStart="@drawable/file_browser_sort" android:drawablePadding="6dp" style="@style/FileBrowser.Tool" android:layout_width="wrap_content" android:layout_height="36dp" android:text="名称升序" android:textColor="@color/cinema_text"/>
<TextView android:id="@+id/browser_refresh" android:drawableStart="@drawable/file_browser_refresh" android:drawablePadding="6dp" style="@style/FileBrowser.Tool" android:layout_width="wrap_content" android:layout_height="36dp" android:text="刷新" android:textColor="@color/cinema_text"/>
<TextView android:id="@+id/browser_tools" style="@style/FileBrowser.Tool" android:layout_width="wrap_content" android:layout_height="36dp" android:text="⋯" android:textColor="@color/cinema_text"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="17dp" android:layout_marginBottom="8dp" android:paddingStart="32dp" android:paddingEnd="32dp" android:gravity="center_vertical">
<androidx.recyclerview.widget.RecyclerView android:id="@+id/path_rv" app:tvDpadList="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="4dp" android:paddingEnd="4dp"/>
<TextView android:id="@+id/directory_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#9999A7" android:textSize="11sp" android:paddingEnd="4dp" android:paddingStart="12dp"/>
</LinearLayout>
<FrameLayout android:id="@+id/fragment_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="32dp" android:layout_marginEnd="32dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="47dp" android:paddingStart="36dp" android:paddingEnd="36dp" android:gravity="center_vertical">
<TextView android:id="@+id/browser_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/cinema_muted" android:textSize="11sp"/>
<TextView android:id="@+id/browser_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="方向键 选择    确定 打开    菜单 更多    返回 上一级" android:textColor="#9999A7" android:textSize="11sp"/>
</LinearLayout>
</LinearLayout>
</layout>
