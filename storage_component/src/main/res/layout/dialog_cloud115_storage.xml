<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import
            type="com.xyoye.data_component.entity.MediaLibraryEntity" />
        <variable
            name="library"
            type="MediaLibraryEntity" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_display_name"
                android:textColor="@color/cinema_muted"
                android:textSize="12sp"
                android:labelFor="@id/display_name_et" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/display_name_et"
                android:background="@drawable/cinema_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_display_name"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@={library.displayName}"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/auth_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cinema_surface">
            <TextView
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:background="@drawable/cinema_surface"
                android:gravity="center"
                android:text="授权状态"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/auth_status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_theme"
                android:textSize="14sp"
                tools:text="未授权" />
            <TextView
                android:id="@+id/auth_action_tv"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/cinema_category"
                android:focusable="true"
                android:gravity="center"
                android:text="授权"
                android:textColor="@color/text_black"
                android:textSize="14sp" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/url_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/cinema_surface">
            <TextView
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:background="@drawable/cinema_surface"
                android:gravity="center"
                android:text="账号标识"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/url_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_theme"
                android:textSize="14sp"
                tools:text="115cloud://uid/123456" />
        </FrameLayout>
        <TextView
            android:id="@+id/hint_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="授权完成后自动保存。连接失效时，可重新授权。"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/disconnect_tv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/background_button_corner_red"
            android:focusable="true"
            android:gravity="center"
            android:text="断开连接/清除授权"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</layout>
