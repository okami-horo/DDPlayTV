<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/license_reading_focus_fill" />
            <stroke android:width="@dimen/tv_focus_stroke_width" android:color="@color/text_black" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item
                android:height="1dp"
                android:gravity="bottom"
                android:left="15dp"
                android:right="15dp"
                android:drawable="@color/item_border_color" />
        </layer-list>
    </item>
</selector>
