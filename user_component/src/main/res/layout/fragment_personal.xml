<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="viewModel" type="com.xyoye.user_component.ui.fragment.personal.PersonalFragmentViewModel" />
    </data>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:defaultFocusHighlightEnabled="false" android:background="@color/cinema_background">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="36dp" android:paddingBottom="24dp" android:orientation="vertical">
            <LinearLayout android:id="@+id/user_account_cl" android:layout_width="match_parent" android:layout_height="82dp" android:padding="16dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true">
                <com.xyoye.common_component.weight.CircleImageView android:id="@+id/user_cover_iv" android:layout_width="48dp" android:layout_height="48dp" android:transitionName="user_cover_image" />
                <TextView android:id="@+id/user_name_tv" style="@style/Cinema.Section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" />
                <TextView android:id="@+id/tips_login_bt" style="@style/Cinema.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="登录  ›" />
            </LinearLayout>
            <LinearLayout android:id="@+id/follow_anime_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="追番记录" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <TextView android:id="@+id/follow_anime_tv" style="@style/Cinema.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cloud_history_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="云端历史" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <TextView android:id="@+id/cloud_history_tv" style="@style/Cinema.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/player_setting_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="播放设置" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/scan_manager_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="扫描管理" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cache_manager_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="缓存管理" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/commonly_manager_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="常用文件夹" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/shooter_subtitle_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="字幕下载" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/screencast_receiver_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="投屏接收" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <TextView android:id="@+id/screencast_status_tv" style="@style/Cinema.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="接收中" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/app_setting_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="应用设置" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/developer_setting_ll" android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:background="@drawable/cinema_card" android:focusable="true" android:clickable="true" android:tag="@string/focusable_item">
                <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="开发者选项" android:textColor="@color/cinema_text" android:textSize="16sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="14dp" android:src="@drawable/cinema_ic_next" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>