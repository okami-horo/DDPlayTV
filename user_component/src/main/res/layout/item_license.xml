<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:focusable="true"
        android:tag="@string/focusable_item"
        android:background="@drawable/license_reading_focus">

        <TextView
            android:id="@+id/project_tv"
            android:autoLink="web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_black"
            android:textColorLink="@color/text_theme"
            android:padding="15dp" />

        <TextView
            android:id="@+id/license_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textSize="14sp"
            android:textColor="@color/license_body_text"
            android:gravity="start"
            android:padding="10dp" />

    </LinearLayout>
</layout>
