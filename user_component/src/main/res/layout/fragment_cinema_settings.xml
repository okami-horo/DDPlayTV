<layout xmlns:android="http://schemas.android.com/apk/res/android"><data><variable name="viewModel" type="com.xyoye.user_component.ui.activities.setting_app.SettingAppViewModel"/></data>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="80dp" android:paddingHorizontal="@dimen/cinema_gutter" android:paddingBottom="24dp" android:background="@color/cinema_background">
<TextView style="@style/Cinema.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置"/>
<TextView style="@style/Cinema.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="让每次观看，都合你的习惯。"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="24dp">
