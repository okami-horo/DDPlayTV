<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扫描时只识别下列格式的文件。" />
        <TextView
            style="@style/Cinema.Section"
            android:textSize="14sp"
            android:textStyle="normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扩展名 · 用英文逗号分隔"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_video_extension"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/cinema_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/cinema_text"
            android:textColorHint="@color/cinema_muted"
            android:textSize="14sp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:gravity="top|start"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:maxLines="4" />
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="不需要输入点号。例如：mkv,mp4,avi"
            android:layout_marginTop="8dp" />
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:id="@+id/error_tv"
            android:visibility="gone"
            android:textColor="#FFB4AB"
            android:accessibilityLiveRegion="polite"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/tv_reset_extension"
            style="@style/Cinema.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="恢复默认并保存"
            android:layout_marginTop="12dp" />
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="恢复默认会立即保存；编辑后选择「保存」。"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</layout>