<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import
            type="com.xyoye.user_component.ui.activities.about_us.AboutUsViewModel" />
        <variable
            name="viewModel"
            type="com.xyoye.user_component.ui.activities.about_us.AboutUsViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cinema_background">
        <include
            android:id="@+id/toolbar_layout"
            layout="@layout/layout_toolbar" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:paddingHorizontal="36dp"
            android:paddingVertical="24dp">
            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="24dp"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/app_iv"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cinema_brand"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp" />
                <TextView
                    android:id="@+id/app_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DDPlayTV"
                    android:textColor="@color/text_black"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp" />
                <TextView
                    android:id="@+id/version_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="24dp"
                android:background="@drawable/cinema_surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/app_describe_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_gray"
                        android:textSize="15sp"
                        android:lineSpacingExtra="5dp"
                        android:layout_marginBottom="24dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="18dp">
                        <ImageView
                            android:layout_width="154dp"
                            android:layout_height="20dp"
                            android:src="@drawable/tmdb_logo"
                            android:contentDescription="TMDB" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:textColor="@color/text_gray"
                            android:text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/official_address_tv"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="@string/text_official_address"
                        android:textColor="@color/text_theme"
                        android:textSize="14sp"
                        android:focusable="true"
                        android:gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/cinema_button" />
                    <TextView
                        android:id="@+id/source_address_tv"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="@string/text_github_project_name"
                        android:textColor="@color/text_theme"
                        android:textSize="14sp"
                        android:focusable="true"
                        android:gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/cinema_button" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </LinearLayout>
</layout>
