<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="viewModel"
            type="com.xyoye.user_component.ui.activities.metadata.MetadataSettingsViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cinema_background"
        android:paddingHorizontal="36dp"
        android:paddingVertical="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="作品资料与扫描任务"
            android:textSize="24sp"
            android:textColor="@color/cinema_text" />
        <TextView
            android:id="@+id/configuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="16sp"
            android:textColor="@color/cinema_muted" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无扫描任务"
            android:textColor="@color/cinema_muted" />
        <com.rubensousa.dpadrecyclerview.DpadRecyclerView
            android:id="@+id/tasks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false"
            android:layout_marginVertical="12dp"
            android:background="@drawable/cinema_surface" />
        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cinema_muted" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <Button
                style="@style/Cinema.Button"
                android:id="@+id/clear_cache"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="清理 TMDB 请求缓存" />
            <Button
                style="@style/Cinema.Button"
                android:id="@+id/clear_images"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="清理图片缓存" />
            <Button
                style="@style/Cinema.Button"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="返回" />
        </LinearLayout>
    </LinearLayout>
</layout>
