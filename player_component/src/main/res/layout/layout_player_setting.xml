<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_gravity="end"
        android:layout_margin="15dp"
        android:padding="18dp"
        android:translationX="300dp"
        android:background="@drawable/cinema_player_panel">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="播放设置"
                android:textColor="@color/cinema_text"
                android:textSize="20sp" />
            <ImageView
                android:id="@+id/panel_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/cinema_ic_close"
                android:padding="6dp"
                android:contentDescription="关闭面板"
                android:focusable="true"
                android:background="@drawable/cinema_icon_circle" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            app:tvDpadList="true"
            android:id="@+id/setting_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:focusable="true"
            android:padding="4dp"
            android:layout_weight="1" />
    </LinearLayout>
</layout>
