<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <FrameLayout
        android:id="@+id/keyword_block_ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        tools:alpha="1"
        tools:visibility="visible">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="264dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_margin="15dp"
            android:background="@drawable/cinema_player_panel"
            android:clickable="true"
            android:padding="18dp">
            <TextView
                android:id="@+id/keyword_block_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tips_keyword_block"
                android:textColor="@color/text_white_immutable"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@+id/iv_close"
                android:contentDescription="关闭面板"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/cinema_icon_circle"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/cinema_ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <EditText
                android:id="@+id/keyword_block_add_et"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/cinema_button"
                android:hint="@string/tips_support_regex"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="50"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_white_immutable"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/keyword_block_add_tv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/keyword_block_title" />
            <TextView
                android:id="@+id/keyword_block_add_tv"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:background="@drawable/cinema_button"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_add_block_keyword"
                android:textColor="@color/text_white_immutable"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/keyword_block_add_et"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/keyword_block_add_et" />
            <TextView
                android:id="@+id/keyword_block_list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="已添加的关键字"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/keyword_block_add_et" />
            <TextView
                android:id="@+id/keyword_block_remove_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tips_remove_block_keyword"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/keyword_block_list_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/keyword_rv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                app:tvDpadList="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/keyword_block_remove_tips" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>
