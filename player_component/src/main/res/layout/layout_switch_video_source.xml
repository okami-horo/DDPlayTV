<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/cl_root"
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="15dp"
        android:padding="18dp"
        android:orientation="vertical"
        android:background="@drawable/cinema_player_panel"
        android:translationX="300dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/switch_video_source_tv"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="选集"
                android:textSize="20sp"
                android:textColor="@color/cinema_text" />
            <ImageView
                android:id="@+id/panel_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:background="@drawable/cinema_icon_circle"
                android:src="@drawable/cinema_ic_close"
                android:contentDescription="关闭面板"
                android:focusable="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/source_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/cinema_muted"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/source_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="4dp"
            android:layout_marginTop="10dp"
            app:tvDpadList="true" />
        <TextView
            android:id="@+id/source_full_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/cinema_muted"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="上下选择 · 确认切换&#10;返回后回到选集按钮。"
            android:textColor="@color/cinema_muted"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</layout>
