<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="135.333dp"
        android:background="@drawable/cinema_subtitle_menu"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="10.667dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10.667dp"
            android:layout_marginBottom="8dp"
            android:includeFontPadding="false"
            android:text="字幕"
            android:textColor="@color/cinema_text"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/subtitle_quick_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10.667dp"
            android:layout_marginBottom="8dp"
            android:text="暂无可用字幕，可在右侧设置添加"
            android:textColor="@color/cinema_muted"
            android:textSize="14sp"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subtitle_quick_list"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:paddingEnd="6.667dp"
            android:scrollbars="vertical"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarSize="2dp"
            android:scrollbarTrackVertical="@drawable/cinema_subtitle_scrollbar_track"
            android:scrollbarThumbVertical="@drawable/cinema_subtitle_scrollbar_thumb"
            android:fadeScrollbars="false"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="20dp"
            tools:listitem="@layout/item_subtitle_quick" />
    </LinearLayout>
</layout>
