<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout android:layout_width="264dp" android:layout_height="match_parent" android:layout_gravity="end" android:layout_margin="15dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/cinema_player_panel" android:translationX="300dp" tools:translationX="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="@color/cinema_text" />
            <ImageView android:id="@+id/panel_close" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/cinema_icon_circle" android:padding="6dp" android:src="@drawable/cinema_ic_close" android:contentDescription="关闭面板" android:focusable="true" />
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/track_visible" android:layout_width="match_parent" android:layout_height="48dp" android:text="显示" android:textColor="@color/cinema_text" android:textSize="14sp" android:background="@drawable/cinema_card" android:thumb="@drawable/cinema_switch_thumb" app:track="@drawable/cinema_switch_background" app:splitTrack="false" />
        <TextView android:id="@+id/tv_empty_track" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="暂无可用轨道" android:textColor="@color/cinema_muted" android:textSize="12sp" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_track" app:tvDpadList="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="4dp" />
        <Button android:id="@+id/tv_add_track" style="@style/Cinema.Button" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginEnd="0dp" android:layout_marginTop="8dp" android:text="添加轨道" />
        <Button android:id="@+id/track_style" style="@style/Cinema.Button" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginEnd="0dp" android:layout_marginTop="8dp" android:text="显示样式" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="返回键关闭面板，继续观看。" android:textColor="@color/cinema_muted" android:textSize="11sp" />
    </LinearLayout>
</layout>