<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/setting_layout"
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="15dp"
        android:padding="18dp"
        android:orientation="vertical"
        android:background="@drawable/cinema_player_panel"
        android:translationX="300dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/offset_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="时间偏移"
                android:textSize="20sp"
                android:textColor="@color/cinema_text" />
            <ImageView
                android:id="@+id/panel_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:background="@drawable/cinema_icon_circle"
                android:src="@drawable/cinema_ic_close"
                android:contentDescription="关闭面板"
                android:focusable="true" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="修改即时生效"
            android:textColor="@color/cinema_muted"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/cinema_muted"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="20dp" />
                <TextView
                    android:id="@+id/tv_display"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:textSize="36sp"
                    android:textColor="@color/cinema_text" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/tv_reduce_ten"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:layout_height="40dp"
                        android:background="@drawable/cinema_button"
                        android:gravity="center"
                        android:text="-10"
                        android:textColor="@color/cinema_text"
                        android:textSize="14sp"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/tv_add_ten"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_height="40dp"
                        android:background="@drawable/cinema_button"
                        android:gravity="center"
                        android:text="+10"
                        android:textColor="@color/cinema_text"
                        android:textSize="14sp"
                        android:focusable="true" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/tv_reduce_five"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:layout_height="40dp"
                        android:background="@drawable/cinema_button"
                        android:gravity="center"
                        android:text="-5"
                        android:textColor="@color/cinema_text"
                        android:textSize="14sp"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/tv_add_five"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_height="40dp"
                        android:background="@drawable/cinema_button"
                        android:gravity="center"
                        android:text="+5"
                        android:textColor="@color/cinema_text"
                        android:textSize="14sp"
                        android:focusable="true" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/tv_reduce_half"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:layout_height="40dp"
                        android:background="@drawable/cinema_button"
                        android:gravity="center"
                        android:text="-0.5"
                        android:textColor="@color/cinema_text"
                        android:textSize="14sp"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/tv_add_half"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_height="40dp"
                        android:background="@drawable/cinema_button"
                        android:gravity="center"
                        android:text="+0.5"
                        android:textColor="@color/cinema_text"
                        android:textSize="14sp"
                        android:focusable="true" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_reset"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/cinema_button"
                    android:gravity="center"
                    android:text="重置"
                    android:textColor="@color/cinema_text"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:layout_marginTop="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="单位：秒&#10;增加时间提前显示，减少时间延迟显示。"
                    android:textColor="@color/cinema_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="20dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
