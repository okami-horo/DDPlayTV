<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/search_danmu_cl"
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="15dp"
        android:padding="18dp"
        android:orientation="vertical"
        android:background="@drawable/cinema_player_panel"
        android:translationX="300dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tips_search_danmu_tv"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="搜索弹幕"
                android:textSize="20sp"
                android:textColor="@color/cinema_text" />
            <ImageView
                android:id="@+id/panel_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:background="@drawable/cinema_icon_circle"
                android:src="@drawable/cinema_ic_close"
                android:contentDescription="关闭面板"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/search_danmu_et"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/cinema_button"
                android:paddingHorizontal="10dp"
                android:hint="作品名称"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:singleLine="true"
                android:maxLength="50"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/cinema_muted"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/search_danmu_tv"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="@drawable/cinema_button"
                android:gravity="center"
                android:text="搜索"
                android:textColor="@color/cinema_text"
                android:textSize="14sp"
                android:focusable="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/danmu_status_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/cinema_muted"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/danmu_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="4dp"
            android:layout_marginTop="10dp"
            app:tvDpadList="true" />
        <TextView
            android:id="@+id/tv_select_local_danmu"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/cinema_button"
            android:gravity="center"
            android:text="选择本地文件"
            android:textColor="@color/cinema_text"
            android:textSize="14sp"
            android:focusable="true"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择对应分集下载弹幕。"
            android:textColor="@color/cinema_muted"
            android:textSize="12sp"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</layout>
