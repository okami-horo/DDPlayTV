<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <FrameLayout
        android:id="@+id/player_bottom_ll"
        android:layout_width="match_parent"
        android:layout_height="194dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="40dp"
        android:background="@drawable/cinema_controls_bottom"
        android:translationY="194dp"
        tools:translationY="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="76dp"
            android:minHeight="17dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/current_position_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/cinema_text"
                android:textSize="13.333sp" />
            <TextView
                android:id="@+id/decode_type_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:includeFontPadding="false"
                android:textColor="@color/cinema_muted"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/duration_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/cinema_text"
                android:textSize="13.333sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/play_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="91.667dp"
            android:max="100"
            android:maxHeight="3.333dp"
            android:minHeight="3.333dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:focusable="false"
            android:splitTrack="false"
            android:progressDrawable="@drawable/cinema_bottom_seek_progress"
            android:thumb="@drawable/cinema_bottom_seek_thumb" />
        <FrameLayout
            android:id="@+id/player_bottom_actions"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="118.667dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/transport_tray"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/rewind"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:background="@drawable/cinema_transport_button"
                    android:stateListAnimator="@animator/cinema_bottom_control"
                    android:src="@drawable/cinema_ic_rewind"
                    app:tint="@color/cinema_bottom_icon"
                    android:focusable="true"
                    android:contentDescription="后退15秒" />
                <ImageView
                    android:id="@+id/play_iv"
                    android:layout_width="42.667dp"
                    android:layout_height="42.667dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/cinema_play_circle"
                    android:stateListAnimator="@animator/cinema_bottom_control"
                    android:src="@drawable/ic_play_bt"
                    app:tint="@color/cinema_background"
                    android:padding="11dp"
                    android:focusable="true"
                    android:contentDescription="播放 / 暂停" />
                <ImageButton
                    android:id="@+id/forward"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/cinema_transport_button"
                    android:stateListAnimator="@animator/cinema_bottom_control"
                    android:src="@drawable/cinema_ic_forward"
                    app:tint="@color/cinema_bottom_icon"
                    android:focusable="true"
                    android:contentDescription="前进15秒" />
                <Space
                    android:id="@+id/episode_divider"
                    android:layout_width="12dp"
                    android:layout_height="1dp" />
                <ImageView
                    android:id="@+id/iv_previous_source"
                    android:layout_width="30.667dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6.667dp"
                    android:padding="5.333dp"
                    android:background="@drawable/cinema_transport_button"
                    android:stateListAnimator="@animator/cinema_bottom_control"
                    android:src="@drawable/cinema_bottom_previous"
                    app:tint="@color/cinema_bottom_icon"
                    android:focusable="true"
                    android:visibility="gone"
                    android:contentDescription="上一集" />
                <ImageView
                    android:id="@+id/iv_next_source"
                    android:layout_width="30.667dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6.667dp"
                    android:padding="5.333dp"
                    android:background="@drawable/cinema_transport_button"
                    android:stateListAnimator="@animator/cinema_bottom_control"
                    android:src="@drawable/cinema_bottom_next"
                    app:tint="@color/cinema_bottom_icon"
                    android:focusable="true"
                    android:visibility="gone"
                    android:contentDescription="下一集" />
                <LinearLayout
                    android:id="@+id/video_list_iv"
                    android:layout_width="60dp"
                    android:layout_height="33.333dp"
                    android:gravity="center"
                    android:background="@drawable/cinema_bottom_pill"
                    android:stateListAnimator="@animator/cinema_bottom_control"
                    android:contentDescription="选集"
                    android:descendantFocusability="blocksDescendants"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/cinema_bottom_episodes"
                        app:tint="@color/cinema_bottom_icon" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5.333dp"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:text="选集"
                        android:textColor="@color/cinema_bottom_icon"
                        android:textSize="13.333sp"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                </LinearLayout>
                <TextView
                    android:id="@+id/single_video_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="单个视频"
                    android:textSize="12sp"
                    android:textColor="@color/cinema_muted"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clipChildren="false"
                android:clipToPadding="false">
                <FrameLayout
                    android:layout_width="38.667dp"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <ImageButton
                        android:id="@+id/subtitle_control_iv"
                        android:layout_width="38.667dp"
                        android:layout_height="38.667dp"
                        android:layout_marginTop="2.667dp"
                        android:padding="10dp"
                        android:background="@drawable/cinema_bottom_track_button"
                        android:stateListAnimator="@animator/cinema_bottom_control"
                        android:src="@drawable/cinema_bottom_subtitle"
                        app:tint="@color/cinema_bottom_icon"
                        android:focusable="true"
                        android:contentDescription="字幕" />
                    <TextView
                        style="@style/Cinema.BottomControlLabel"
                        android:text="字幕" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="38.667dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <ImageButton
                        android:id="@+id/audio_control"
                        android:layout_width="38.667dp"
                        android:layout_height="38.667dp"
                        android:layout_marginTop="2.667dp"
                        android:padding="10dp"
                        android:background="@drawable/cinema_bottom_track_button"
                        android:stateListAnimator="@animator/cinema_bottom_control"
                        android:src="@drawable/cinema_bottom_audio"
                        app:tint="@color/cinema_bottom_icon"
                        android:focusable="true"
                        android:contentDescription="音轨" />
                    <TextView
                        style="@style/Cinema.BottomControlLabel"
                        android:text="音轨" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="38.667dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <ImageButton
                        android:id="@+id/danmu_control_iv"
                        android:layout_width="38.667dp"
                        android:layout_height="38.667dp"
                        android:layout_marginTop="2.667dp"
                        android:padding="10dp"
                        android:background="@drawable/cinema_bottom_track_button"
                        android:stateListAnimator="@animator/cinema_bottom_control"
                        android:src="@drawable/cinema_bottom_danmaku"
                        app:tint="@color/cinema_bottom_icon"
                        android:focusable="true"
                        android:contentDescription="@string/player_danmaku_disable_action" />
                    <TextView
                        android:id="@+id/danmu_control_label"
                        style="@style/Cinema.BottomControlLabel"
                        android:text="@string/player_danmaku_on" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:id="@+id/transport_focus_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="166dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/cinema_text"
            android:textSize="12sp"
            android:importantForAccessibility="no"
            android:visibility="invisible" />
    </FrameLayout>
</layout>
