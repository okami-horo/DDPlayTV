<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/cinema_button" />
    <item android:state_focused="true" android:drawable="@drawable/cinema_button" />
    <item android:state_pressed="true" android:drawable="@drawable/cinema_button" />
    <item android:state_selected="true" android:drawable="@drawable/cinema_button" />
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#05FFFFFF" />
                </shape>
            </item>
            <item android:height="1dp" android:gravity="bottom">
                <shape>
                    <solid android:color="#0DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
