<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/cinema_focus_pressed_fill" />
            <corners android:radius="5dp" />
            <stroke android:width="@dimen/tv_focus_stroke_width" android:color="@color/cinema_focus_edge" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/cinema_focus_fill" />
            <corners android:radius="5dp" />
            <stroke android:width="@dimen/tv_focus_stroke_width" android:color="@color/cinema_focus_edge" />
        </shape>
    </item>
</selector>
