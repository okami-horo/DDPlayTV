<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><corners android:radius="12dp"/><solid android:color="#40404A"/><stroke android:width="3dp" android:color="#F5F5F7"/></shape></item>
    <item android:state_selected="true"><shape><corners android:radius="12dp"/><solid android:color="#34343E"/><stroke android:width="1dp" android:color="#88FFFFFF"/></shape></item>
    <item android:state_pressed="true"><shape><corners android:radius="12dp"/><solid android:color="#40404A"/></shape></item>
    <item><shape><corners android:radius="12dp"/><solid android:color="#25252D"/></shape></item>
</selector>
