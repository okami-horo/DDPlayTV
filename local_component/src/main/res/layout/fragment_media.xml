<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data><variable name="viewModel" type="com.xyoye.local_component.ui.fragment.media.MediaViewModel"/></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cinema_background" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="90dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Cinema.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="媒体来源"/>
                <TextView style="@style/Cinema.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="本地文件与网络收藏，在这里汇集。"/>
            </LinearLayout>
            <Button android:id="@+id/add_media_storage_bt" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="44dp" android:text="＋ 添加来源" android:contentDescription="@string/action_add_media_storage" android:nextFocusDown="@id/media_lib_rv"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/media_lib_rv" app:tvDpadList="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp"/>
    </LinearLayout>
</layout>
