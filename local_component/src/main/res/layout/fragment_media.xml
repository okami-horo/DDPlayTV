<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="viewModel" type="com.xyoye.local_component.ui.fragment.media.MediaViewModel" />
    </data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="80dp" android:paddingHorizontal="@dimen/cinema_gutter" android:paddingBottom="20dp" android:orientation="vertical" android:background="@color/cinema_background">
        <TextView style="@style/Cinema.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="媒体库" />
        <TextView style="@style/Cinema.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:text="全部来源  ›  视频" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/media_lib_rv" app:tvDpadList="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:clipToPadding="false" android:padding="4dp" />
            <Button android:id="@+id/add_media_storage_bt" android:nextFocusDown="@id/metadata_tasks" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="12dp" android:text="＋ 添加来源" android:contentDescription="@string/action_add_media_storage" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView style="@style/Cinema.Section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="最近添加" />
            <Button android:id="@+id/metadata_tasks" android:nextFocusRight="@id/show_all" android:nextFocusDown="@id/library_cards" android:background="@drawable/cinema_category" android:textColor="@color/cinema_muted" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="36dp" android:text="资料与任务" />
            <Button android:id="@+id/show_all" android:nextFocusLeft="@id/metadata_tasks" android:nextFocusDown="@id/library_cards" android:background="@drawable/cinema_category" android:textColor="@color/cinema_muted" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="36dp" android:text="全部作品  ›" />
        </LinearLayout>
        <TextView android:id="@+id/library_count" style="@style/Cinema.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" />
        <com.rubensousa.dpadrecyclerview.DpadRecyclerView android:id="@+id/library_cards" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginHorizontal="-8dp" android:clipToPadding="false" />
    </LinearLayout>
</layout>