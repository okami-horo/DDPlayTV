<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import
            type="com.xyoye.local_component.ui.activities.play_history.PlayHistoryViewModel" />
        <import
            type="android.view.View" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cinema_background">
        <include
            layout="@layout/layout_toolbar" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="观看记录 · 保留原来源与播放进度"
            android:textColor="@color/cinema_muted"
            android:textSize="13sp"
            android:paddingHorizontal="36dp"
            android:paddingBottom="16dp" />
        <androidx.recyclerview.widget.RecyclerView
            app:tvDpadList="true"
            android:id="@+id/play_history_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="36dp"
            android:layout_marginBottom="24dp"
            android:padding="12dp"
            android:clipToPadding="false"
            android:background="@drawable/cinema_surface" />
    </LinearLayout>
</layout>
