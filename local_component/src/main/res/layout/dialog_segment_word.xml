<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择候选词拼接搜索内容，也可直接编辑。" />
        <TextView
            style="@style/Cinema.Section"
            android:textSize="14sp"
            android:textStyle="normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="搜索内容"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:id="@+id/search_cl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/search_et"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:background="@drawable/cinema_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/cinema_text"
                android:textColorHint="@color/cinema_muted"
                android:textSize="14sp"
                android:hint="@string/hint_search_word"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:nextFocusRight="@id/clear_text_iv" />
            <Button
                android:id="@+id/clear_text_iv"
                style="@style/Cinema.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="清空"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="0dp"
                android:nextFocusLeft="@id/search_et" />
        </LinearLayout>
        <TextView
            style="@style/Cinema.Section"
            android:textSize="14sp"
            android:textStyle="normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="候选词"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />
        <com.xyoye.common_component.weight.LabelsView
            android:id="@+id/candidate_labels_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBackground="@drawable/cinema_button"
            app:labelTextColor="@color/cinema_text"
            app:labelTextSize="14sp"
            app:labelTextPaddingLeft="14dp"
            app:labelTextPaddingRight="14dp"
            app:labelTextPaddingTop="12dp"
            app:labelTextPaddingBottom="12dp"
            app:lineMargin="10dp"
            app:wordMargin="10dp"
            app:selectType="NONE" />
        <TextView
            style="@style/Cinema.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="没有候选词，可直接输入搜索内容。"
            android:id="@+id/empty_tv"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</layout>