<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/download_path_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tips_download_path"
            android:textColor="@color/text_black"
            android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/download_path_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="12sp"
            tools:text=""
            android:ellipsize="middle" />
        <TextView
            android:id="@+id/source_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tips_danmu_source"
            android:textColor="@color/text_black"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />
        <RadioGroup
            android:id="@+id/rg_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_all_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:background="@drawable/cinema_card"
                android:checked="true"
                android:minHeight="48dp"
                android:nextFocusDown="@id/positive_bt"
                android:nextFocusRight="@id/rb_official_source"
                android:paddingEnd="12dp"
                android:text="@string/danmu_download_all"
                android:theme="@style/Theme.DanDanPlay.CheckBox"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textColor="@color/cinema_text"
                android:buttonTint="@color/cinema_text" />
            <RadioButton
                android:id="@+id/rb_official_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:background="@drawable/cinema_card"
                android:minHeight="48dp"
                android:nextFocusDown="@id/positive_bt"
                android:nextFocusLeft="@id/rb_all_source"
                android:paddingEnd="12dp"
                android:text="@string/danmu_download_official"
                android:theme="@style/Theme.DanDanPlay.CheckBox"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textColor="@color/cinema_text"
                android:buttonTint="@color/cinema_text" />
        </RadioGroup>
    </LinearLayout>
</layout>
