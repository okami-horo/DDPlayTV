<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/file_name_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tips_subtitle_zip_name"
            android:textColor="@color/text_black"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/file_name_et"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:hint=""
                android:maxLines="1"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_black"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp"
                android:layout_weight="1"
                android:paddingHorizontal="12dp"
                android:background="@drawable/cinema_input" />
            <TextView
                android:id="@+id/file_extension_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                tools:text=".zip"
                android:layout_marginStart="10dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/file_size_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cinema_muted"
            android:textSize="14sp"
            tools:text="文件大小：100M"
            android:layout_marginTop="12dp" />
        <TextView
            android:id="@+id/file_count_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cinema_muted"
            android:textSize="14sp"
            tools:text="文件数量：10"
            android:layout_marginTop="12dp" />
        <TextView
            android:id="@+id/subtitle_language_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cinema_muted"
            android:textSize="14sp"
            tools:text="字幕语种：中文"
            android:layout_marginTop="12dp" />
        <TextView
            android:id="@+id/subtitle_time_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cinema_muted"
            android:textSize="14sp"
            tools:text="上传时间：2020-12-9 12:22"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</layout>
