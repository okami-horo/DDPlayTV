<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data><variable name="viewModel" type="com.xyoye.local_component.ui.metadata.MetadataLibraryViewModel" /></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#101116" android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:paddingHorizontal="36dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶  DDPlayTV" android:textSize="10sp" android:textColor="@color/cinema_text" android:textStyle="bold" />
            <TextView style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="作品详情" android:textSize="10sp" />
            <TextView android:id="@+id/source_label" style="@style/Cinema.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:maxWidth="300dp" android:ellipsize="end" android:textSize="10sp" />
        </LinearLayout>
        <FrameLayout android:id="@+id/detail_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="225dp" android:clipChildren="false" android:clipToPadding="false">
            <ImageView android:id="@+id/backdrop" android:layout_width="430dp" android:layout_height="225dp" android:layout_gravity="end" android:alpha="0.05" android:foreground="@drawable/series_backdrop_scrim" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <com.xyoye.common_component.weight.RoundedArtworkLayout android:id="@+id/poster_frame" android:visibility="gone" android:layout_width="119dp" android:layout_height="178dp" android:layout_gravity="top|end" android:layout_marginEnd="70dp" android:layout_marginTop="10dp" android:rotation="3" android:background="@drawable/cinema_image">
                <ImageView android:id="@+id/poster" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            </com.xyoye.common_component.weight.RoundedArtworkLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="41dp" android:layout_marginEnd="339dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
                <TextView android:id="@+id/title" android:text="正在读取作品资料…" style="@style/Cinema.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:includeFontPadding="false" android:breakStrategy="balanced" />
                <TextView android:id="@+id/work_meta" android:visibility="gone" style="@style/Cinema.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textSize="10sp" android:includeFontPadding="false" />
                <TextView android:id="@+id/overview" style="@style/Cinema.Body" android:layout_width="500dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="11sp" android:lineSpacingExtra="4dp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
                    <Button android:id="@+id/resume" android:alpha="0.45" style="@style/Cinema.Primary" android:layout_width="wrap_content" android:layout_height="47dp" android:layout_marginStart="-5dp" android:layout_marginEnd="6dp" android:text="开始观看" android:textSize="13sp" android:paddingHorizontal="22dp" android:nextFocusRight="@id/synopsis" android:drawableStart="@drawable/cinema_ic_play" android:drawableTint="@color/cinema_background" android:drawablePadding="8dp" android:focusable="false" android:enabled="false" />
                    <Button android:id="@+id/synopsis" android:visibility="gone" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="36dp" android:text="完整简介" android:textSize="10sp" android:minWidth="0dp" android:paddingHorizontal="12dp" android:nextFocusLeft="@id/resume" android:nextFocusRight="@id/correct" android:focusable="false" />
                    <Button android:id="@+id/correct" android:visibility="gone" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/cinema_category" android:text="管理资料" android:textSize="10sp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:nextFocusLeft="@id/synopsis" android:nextFocusRight="@id/correct" android:focusable="false" />
                </LinearLayout>
                <TextView android:id="@+id/resume_note" style="@style/Cinema.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/series_shelf" android:orientation="vertical" android:paddingTop="14dp" android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:paddingHorizontal="41dp" android:gravity="center_vertical" android:clipChildren="false">
                <TextView android:id="@+id/episodes_title" style="@style/Cinema.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剧集" />
                <TextView android:id="@+id/episode_count" style="@style/Cinema.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="10sp" />
                <TextView android:id="@+id/season_label" android:visibility="gone" style="@style/Cinema.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/cinema_surface" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:textSize="10sp" />
                <HorizontalScrollView android:id="@+id/season_scroll" android:layout_width="280dp" android:layout_height="match_parent" android:scrollbars="none" android:visibility="gone" android:clipToPadding="false">
                    <LinearLayout android:id="@+id/seasons" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false" />
                </HorizontalScrollView>
            </LinearLayout>
            <TextView android:id="@+id/hint" style="@style/Cinema.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="41dp" android:textSize="10sp" android:visibility="gone" />
            <com.rubensousa.dpadrecyclerview.DpadRecyclerView android:id="@+id/files" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="35dp" android:paddingEnd="35dp" android:paddingTop="1dp" android:paddingBottom="8dp" android:clipToPadding="false" android:visibility="gone" />
            <LinearLayout android:id="@+id/empty_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/detail_status" style="@style/Cinema.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正在读取作品资料…" />
                <Button android:id="@+id/browse" style="@style/Cinema.Button" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="12dp" android:text="浏览媒体库" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
