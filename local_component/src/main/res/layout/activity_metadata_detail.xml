<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data><variable name="viewModel" type="com.xyoye.local_component.ui.metadata.MetadataLibraryViewModel"/></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="#0B1018">
        <FrameLayout android:layout_width="match_parent" android:layout_height="160dp">
            <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/metadata_scrim"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="28sp" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/overview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#CBD3DF" android:textSize="16sp" android:maxLines="4" android:ellipsize="end"/>
            </LinearLayout>
        </FrameLayout>
        <com.rubensousa.dpadrecyclerview.DpadRecyclerView android:id="@+id/seasons" android:layout_width="match_parent" android:layout_height="82dp"/>
        <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#CBD3DF" android:textSize="14sp"/>
        <com.rubensousa.dpadrecyclerview.DpadRecyclerView android:id="@+id/files" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp">
            <Button android:id="@+id/correct" android:layout_width="wrap_content" android:layout_height="48dp" android:text="更正 / 刷新 / 解除关联"/>
            <Button android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="48dp" android:text="返回"/>
        </LinearLayout>
    </LinearLayout>
</layout>
