<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data><variable name="viewModel" type="com.xyoye.local_component.ui.metadata.MetadataMatchViewModel"/></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/cinema_background">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="识别 / 更正资料" android:textColor="@color/cinema_text" android:textSize="24sp"/>
        <TextView android:id="@+id/file_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:textColor="@color/cinema_muted" android:textSize="14sp" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="55dp" android:maxLines="3" android:ellipsize="end" android:textColor="@color/cinema_muted" android:textSize="15sp" android:paddingTop="8dp"/>
        <LinearLayout android:id="@+id/search_row" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
            <EditText android:id="@+id/query" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:singleLine="true" android:inputType="text" android:textColor="@color/cinema_text" android:hint="作品名称" android:textColorHint="#AAB6C8" android:nextFocusRight="@id/kind"/>
            <Button style="@style/Cinema.Button" android:id="@+id/kind" android:layout_width="150dp" android:layout_height="48dp" android:text="电影" android:nextFocusLeft="@id/query" android:nextFocusRight="@id/search"/>
            <Button style="@style/Cinema.Button" android:id="@+id/search" android:layout_width="120dp" android:layout_height="48dp" android:text="搜索 / 重试" android:nextFocusLeft="@id/kind"/>
        </LinearLayout>
        <com.rubensousa.dpadrecyclerview.DpadRecyclerView android:id="@+id/items" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/range_row" android:layout_width="match_parent" android:layout_height="100dp" android:orientation="vertical" android:visibility="gone">
            <Button style="@style/Cinema.Button" android:id="@+id/first" android:layout_width="match_parent" android:layout_height="48dp" android:text="起始集" android:nextFocusDown="@id/last"/>
            <Button style="@style/Cinema.Button" android:id="@+id/last" android:layout_width="match_parent" android:layout_height="48dp" android:text="结束集" android:nextFocusUp="@id/first"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp">
            <Button style="@style/Cinema.Button" android:id="@+id/confirm" android:layout_width="wrap_content" android:layout_height="48dp" android:text="确认关联" android:visibility="gone"/>
            <Button style="@style/Cinema.Button" android:id="@+id/preview_directory" android:layout_width="wrap_content" android:layout_height="48dp" android:text="预览应用到目录" android:visibility="gone"/>
            <Button style="@style/Cinema.Button" android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="48dp" android:text="刷新已绑定资料"/>
            <Button style="@style/Cinema.Button" android:id="@+id/ignore" android:layout_width="wrap_content" android:layout_height="48dp" android:text="解除关联并忽略"/>
            <Button style="@style/Cinema.Button" android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="48dp" android:text="返回"/>
        </LinearLayout>
    </LinearLayout>
</layout>
